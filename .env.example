# Path to the Bedrock Dedicated Server world directory.
# This is the folder that contains db/, level.dat and levelname.txt
# e.g. /opt/bds/worlds/Bedrock level
WORLD_PATH=/path/to/bedrock/world

# HTTP port for the map server
PORT=3000

# Directory used for the read-only world snapshot and cached map tiles
MAP_CACHE=./cache

# How often the browser polls for player positions (milliseconds)
PLAYER_UPDATE_INTERVAL=3000

# How long player data stays valid without a new update from the BDS addon
# (milliseconds). After this the markers disappear and the map says player data
# is unavailable, rather than showing players who may have left long ago.
PLAYER_DATA_TIMEOUT=10000

# Shared secret required by POST /api/players. The BDS addon sends it as
# "Authorization: Bearer <API_KEY>"; see addons/README.md for where to put it on
# the server side. Without this set, POST /api/players refuses every update.
API_KEY=change-this
