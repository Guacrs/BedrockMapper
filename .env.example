# Path to the Bedrock Dedicated Server world directory.
# This is the folder that contains db/, level.dat and levelname.txt
# e.g. /opt/bds/worlds/Bedrock level
# Not the db/ folder itself, and not the worlds/ parent folder.
WORLD_PATH=/path/to/bedrock/world

# Interface to bind the HTTP server to.
# 127.0.0.1 (default) - only this machine can open the map. Safe.
# 0.0.0.0             - every interface, including LAN and the public internet.
# There is no login. HOST=0.0.0.0 exposes the map, player names and positions
# to anyone who can reach PORT. Put a reverse proxy or firewall in front of it
# if the machine is reachable from the internet.
HOST=127.0.0.1

# HTTP port for the map server
PORT=3000

# Directory used for the read-only world snapshot and cached map tiles.
# Must NOT be inside WORLD_PATH - the map server writes here, and it must never
# write anything inside the live world.
#
# Layout:
#   MAP_CACHE/world-snapshot/<world-id>/<source-id>/db/   copy of the LevelDB
#   MAP_CACHE/tiles/<dimension>/<zoom>/<x>/<y>.png        rendered tiles
#
# Failed copies and leftover *.tmp files are deleted automatically. Valid
# current tiles are kept.
MAP_CACHE=./cache

# How often the map checks the live world for terrain changes (milliseconds).
# Each check is a directory listing; only a world that really changed is
# re-snapshotted, and only the tiles containing changed chunks are redrawn.
# Set to 0 to read the world once at startup and never again.
# Minimum 1000. Default 90000 - live worlds rewrite LevelDB often, and a
# top-down map does not need a redraw every few seconds.
WORLD_REFRESH_INTERVAL=90000

# After a tile is redrawn, ignore further digests for that tile for this many
# milliseconds (same idea as BlueMap's update-cooldown). Added or removed
# chunks still update immediately. 0 disables. Default 60000.
TILE_UPDATE_COOLDOWN=60000

# How many invalidated tiles a refresh redraws at once. Higher finishes faster
# but steals CPU from serving the browser. 1..16, default 2.
REFRESH_RENDER_CONCURRENCY=2

# How often the browser polls for player positions (milliseconds).
# Minimum 500.
PLAYER_UPDATE_INTERVAL=3000

# How long player data stays valid without a new update from the BDS addon
# (milliseconds). After this the markers disappear and the map says player data
# is stale, rather than showing players who may have left long ago.
# Minimum 1000. Should be longer than PLAYER_UPDATE_INTERVAL.
PLAYER_DATA_TIMEOUT=10000

# Shared secret required by POST /api/players. The BDS addon sends it as
# "X-Api-Key: <API_KEY>" (or "Authorization: Bearer <API_KEY>"); see
# addons/README.md for where to put it on the server side.
# Without this set, POST /api/players refuses every update and there are no
# player markers. Use a long random value, not the example.
API_KEY=change-this

# How much the server writes to the console: debug, info, warn, error.
# info is the default. Player movement is never logged; only joins, leaves,
# stale reports and terrain that actually changed.
LOG_LEVEL=info
