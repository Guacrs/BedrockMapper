{
  "name": "bedrock-map",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight top-down web map for an official Minecraft Bedrock Dedicated Server world",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "inspect-world": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/cli/inspect-world.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@8crafter/leveldb-zlib": "^1.6.0",
    "mcbe-leveldb": "^1.23.0",
    "prismarine-nbt": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
